# PostgreSQL connection string. Create the role and database before starting the app (see README).
DATABASE_URL=postgresql+psycopg://outreach_app:YOUR_PASSWORD@localhost:5432/instagram_outreach

# Required for Message Studio (drafting) and Voice Studio (text-to-speech).
# Leave blank to use the app without AI features; pages will show an actionable error when used.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_AUDIO_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Optional: only needed if you wire up Apify-based prospect sourcing.
APIFY_API_TOKEN=

DATA_DIRECTORY=./data
ASSET_DIRECTORY=./data/assets
AUDIO_DIRECTORY=./data/audio
BROWSER_PROFILE_DIR=./data/browser_profile

# Maximum upload size, in megabytes, for the Asset Library and Voice Studio.
# Keep in sync with .streamlit/config.toml's [server] maxUploadSize.
MAX_UPLOAD_SIZE_MB=200
